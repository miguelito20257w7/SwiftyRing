# Plantilla de variables de entorno. Copiar a `.env.development` (local)
# o `.env.production` (servidor) y rellenar con valores reales.
# Este archivo SI se sube a git; los `.env.*` reales NO.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Firma de tokens: RS256 (RF-44) ---
# Antes se usaba HMAC-SHA512 con una unica JWT_KEY compartida. Se cambio porque
# con HMAC la llave que firma y la que verifica son la misma: entregarsela al
# equipo de Control Banos para validar tokens les permitiria tambien EMITIRLOS,
# incluido uno con rol admin. Con RS256 la privada no sale de este servidor
# (RNF-13) y solo se publica la publica, que verifica pero no firma.
#
# Generar el par (desde backend/SwiftyRing/):
#   openssl genrsa -out keys/jwt_private.pem 2048
#   openssl rsa -in keys/jwt_private.pem -pubout -out keys/jwt_public.pem
#   chmod 600 keys/jwt_private.pem
#
# Rutas relativas al directorio desde el que se ejecuta el servidor.
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

# RNF-08: expiracion configurable del token, en horas (por defecto 720 horas = 30 dias).
JWT_EXPIRATION_HOURS=720

# Administrador Principal creado en la inicializacion del sistema (RF-02).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Notificaciones push (FCM) ---
# Ruta al JSON de la cuenta de servicio de Firebase, el archivo que se descarga
# en: consola de Firebase > Configuracion del proyecto > Cuentas de servicio >
# "Generar nueva clave privada".
#
# ES UN SECRETO: quien lo tenga puede enviar notificaciones en nombre del
# colegio. Nunca se sube al repositorio (ya esta en .gitignore).
#
# Si esta variable esta vacia el sistema funciona igual: las notificaciones se
# calculan y se registran en PostgreSQL, pero no se entregan al telefono. El
# timbre nunca depende de que Google responda.
FCM_CREDENTIALS_PATH=keys/fcm-cuenta-servicio.json

# --- Modulo fisico ESP32 ---
# Llave compartida con la que el modulo se autentica (cabecera X-Device-Key).
# El modulo no es un usuario: no tiene correo ni contrasena, tiene esta llave,
# que vive aqui y en el config.h del firmware. Generar una larga y aleatoria:
#   openssl rand -hex 24
# Sin esta variable los endpoints /api/dispositivo/* responden 503.
DEVICE_API_KEY=

LOG_LEVEL=info
