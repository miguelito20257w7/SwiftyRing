{
  // El proyecto Flutter NO está en la raíz de este workspace: vive en `app/`.
  // Por eso hacen falta configuraciones explícitas con `program` y `cwd`; sin
  // ellas la extensión de Dart no sabe qué lanzar desde SwiftyRing/.
  //
  // La primera deja que VS Code use el dispositivo elegido en la barra de
  // estado (o pregunte). Las demás lo fijan, para no depender de ese selector.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Android",
      "request": "launch",
      "type": "dart",
      "args": ["-d", "android"]
    },
    {
      "name": "SwiftyRing",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "app"
    },
    {
      "version": "0.2.0",
      "name": "SwiftyRing · Android (emulador)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "app"
    },
    {
      "version": "0.2.0",
      "name": "SwiftyRing · iPhone (simulador)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "app",
      "deviceId": "ios"
    },
    {
      "version": "0.2.0",
      "name": "SwiftyRing · macOS",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "app",
      "deviceId": "macos"
    },
    {
      "version": "0.2.0",
      "name": "SwiftyRing · Chrome",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "app",
      "deviceId": "chrome"
    },
    {
      "version": "0.2.0",
      "type": "swift",
      "request": "launch",
      "args": [],
      "cwd": "${workspaceFolder:SwiftyRing}/backend/SwiftyRing",
      "name": "Debug SwiftyRing (backend/SwiftyRing)",
      "target": "SwiftyRing",
      "configuration": "debug",
      "preLaunchTask": "swift: Build Debug SwiftyRing (backend/SwiftyRing)"
    },
    {
      "version": "0.2.0",
      "type": "swift",
      "request": "launch",
      "args": [],
      "cwd": "${workspaceFolder:SwiftyRing}/backend/SwiftyRing",
      "name": "Release SwiftyRing (backend/SwiftyRing)",
      "target": "SwiftyRing",
      "configuration": "release",
      "preLaunchTask": "swift: Build Release SwiftyRing (backend/SwiftyRing)"
    }
  ]
}
