<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- El mismo permiso que Runner.entitlements, pero para el entorno de
	     APNs de producción: es el que usan las compilaciones Release y Profile,
	     o sea las que se reparten (TestFlight, .ipa firmado). -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
